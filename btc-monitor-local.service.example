# Compatibility copy; install btc-realtime-monitor.service instead.
[Unit]
Description=BTC real-time Binance WebSocket QQ Bot alert monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/detydanesu/.openclaw/workspace/btc-monitor-local
ExecStart=/usr/bin/node /home/detydanesu/.openclaw/workspace/btc-monitor-local/btc-realtime-monitor.mjs --config /home/detydanesu/.openclaw/workspace/btc-monitor-local/config.json
EnvironmentFile=-/home/detydanesu/.config/btc-realtime-monitor/qqbot.env
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
Environment=HOME=/home/detydanesu
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
